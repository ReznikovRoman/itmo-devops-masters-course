# Вариант "как не надо": неудачный порядок инструкций.
# Любая правка в исходниках (даже в одной строке README) меняет слой `COPY . .`,
# а значит инвалидирует и все слои ниже -- включая `pip install`.
# Результат: на каждый коммит зависимости скачиваются и ставятся заново.
FROM python:3.12

WORKDIR /app

# (1) Копируем все сразу -- кэш слоя зависит от каждого файла в репозитории.
COPY . .

# (2) Зависимости ставятся после копирования исходников.
RUN pip install -r requirements.txt

# (3) Отдельные RUN вместо одного -- лишние слои.
RUN pip install pytest pylint httpx
RUN python -m compileall app

ARG GIT_SHA=unknown
ENV GIT_SHA=$GIT_SHA

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
