# Вариант "как надо" (одностадийный): порядок слоёв от редко меняющегося к часто меняющемуся.
FROM python:3.12-slim

WORKDIR /app

# 1. Сначала только манифест зависимостей. Слой пересобирается, только если изменилось содержимое requirements.txt.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 2. Потом код - он меняется чаще всего, поэтому стоит ближе к концу.
COPY app ./app

# 3. ARG, который меняется на каждый коммит, ставим в самый конец: иначе он инвалидирует все слои ниже него.
ARG GIT_SHA=unknown
ARG APP_VERSION=dev
ENV GIT_SHA=$GIT_SHA \
    APP_VERSION=$APP_VERSION

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
